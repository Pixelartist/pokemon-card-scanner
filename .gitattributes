# Normalise line endings in the repository. Without this a Windows checkout
# rewrites every file and shows ~30 untouched scripts as modified.
* text=auto eol=lf

# Shell scripts must keep LF even if checked out on Windows.
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never diff, convert, merge or LFS-filter these.
#
# The explicit `-filter` matters. `binary` only clears diff/merge/text, so a
# machine-level attributes file that sets `filter=lfs` still wins for that one
# attribute and silently replaces the 5 MB model with a 132-byte LFS pointer on
# `git add` -- which is exactly what happened here.
*.png binary -filter
*.jpg binary -filter
*.jpeg binary -filter
*.webp binary -filter
*.gif binary -filter
*.pt binary -filter
*.onnx binary -filter
*.bin binary -filter
*.wasm binary -filter
*.db binary -filter

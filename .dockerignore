# Keep the build context small: data volumes, weights, caches stay out of the image
.git
.github
.venv
venv
__pycache__
**/__pycache__
data/
!src/data
*.db
*.pt
!src/models/pokemon_card_yolo.pt
*.log
*.pid
.env
.env.*
# Card art lives on the data volume (mounted at runtime), never in the image.
